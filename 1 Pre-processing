import nltk
import re
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer, WordNetLemmatizer
from nltk.tokenize import word_tokenize
# Download the required NLTK resources
nltk.download("punkt", quiet=True)
nltk.download("punkt_tab", quiet=True)
nltk.download("stopwords", quiet=True)
nltk.download("wordnet", quiet=True)
nltk.download("omw-1.4", quiet=True)
# Input text document
original_text = """
Natural Language Processing is an important field of Artificial Intelligence.
Students are learning different techniques for processing text documents.
They are studying, analyzing, and working on projects.
Machine learning models are processing large amounts of data.
Visit https://example.com for more information.
"""
print("Original Text:\n", original_text)
# Step 1: Convert all text to lowercase
text = original_text.lower()
# Step 2: Remove HTML tags
text = re.sub(r"<.*?>", " ", text)
# Step 3: Remove URLs
text = re.sub(r"http\S+|www\S+", " ", text)
# Step 4: Remove punctuation, numbers and special characters
text = re.sub(r"[^a-z\s]", " ", text)
# Step 5: Remove extra spaces
text = re.sub(r"\s+", " ", text).strip()
# Step 6: Split the text into individual words
tokens = word_tokenize(text)
print("\nTokens:\n", tokens)
# Step 7: Remove common English stop words
stop_words = set(stopwords.words("english"))
filtered_words = [
    word for word in tokens
    if word not in stop_words
]
print("\nAfter Stop Word Removal:\n", filtered_words)
# Step 8: Reduce words to their stems using Porter Stemmer
stemmer = PorterStemmer()
stemmed_words = [
    stemmer.stem(word)
    for word in filtered_words
]
print("\nAfter Porter Stemming:\n", stemmed_words)
# Step 9: Reduce words to their meaningful root forms using WordNet Lemmatizer
lemmatizer = WordNetLemmatizer()
lemmatized_words = [
    lemmatizer.lemmatize(word, pos="v")
    for word in filtered_words
]
# Apply noun lemmatization to the output of verb lemmatization
lemmatized_words = [
    lemmatizer.lemmatize(word, pos="n")
    for word in lemmatized_words
]
print("\nAfter WordNet Lemmatization:\n", lemmatized_words)
# Step 10: Combine the stemmed words into final text
stemmed_text = " ".join(stemmed_words)
print("\nFinal Preprocessed Text using Stemming:\n", stemmed_text)
# Step 11: Combine the lemmatized words into final text
lemmatized_text = " ".join(lemmatized_words)
print("\nFinal Preprocessed Text using Lemmatization:\n", lemmatized_text)
