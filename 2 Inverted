# 2. Implement a program for retrieval of documents using inverted files.

import re

# Document collection
documents = {
    1: "Python is used for machine learning",
    2: "Machine learning is part of artificial intelligence",
    3: "Python is used in data science",
    4: "Artificial intelligence uses data"
}

# Create inverted index
inverted_index = {}

for doc_id, text in documents.items():
    words = set(re.findall(r'\b\w+\b', text.lower()))

    for word in words:
        inverted_index.setdefault(word, set()).add(doc_id)

print("Inverted Index:")
for word, doc_ids in sorted(inverted_index.items()):
    print(word, ":", sorted(doc_ids))

# Search documents
query = re.findall(r'\b\w+\b', input("\nEnter search query: ").lower())

results = set(documents.keys())

for word in query:
    results &= inverted_index.get(word, set())

print("\nRetrieved Documents:")

if results:
    for doc_id in sorted(results):
        print(f"Document {doc_id}: {documents[doc_id]}")
else:
    print("No matching documents found.")


