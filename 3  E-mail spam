# Step 1: Import required libraries
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.pipeline import Pipeline
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    ConfusionMatrixDisplay
)
# Step 2: Load the email dataset
file_path = r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\IR\spam_ham_dataset.csv"
df = pd.read_csv(file_path)
print("DATASET LOADED SUCCESSFULLY")
print("\nFirst five records:\n", df.head())
print("\nDataset shape:", df.shape)
print("\nOriginal column names:", df.columns.tolist())
print("\nMissing values:\n", df.isnull().sum())
print("\nClass distribution:\n", df["label"].value_counts())
# Step 3: Standardize column names and identify email text
df.columns = df.columns.str.strip().str.lower()
# Remove unnecessary index columns
df = df.loc[:, ~df.columns.str.startswith("unnamed")]
# Support common column names for email text and labels
text_col = next(
    (col for col in ["email_text", "text", "message", "email", "body"]
     if col in df.columns),
    None
)
label_col = next(
    (col for col in ["label", "category", "class", "v1"]
     if col in df.columns),
    None
)
if text_col is None or label_col is None:
    raise ValueError(
        f"Email text or label column not found. Available columns: "
        f"{df.columns.tolist()}"
    )
# Rename columns to standard names
df.rename(
    columns={text_col: "email_text", label_col: "label"},
    inplace=True
)
# Step 4: Clean email text and labels
df.dropna(subset=["email_text", "label"], inplace=True)
df["email_text"] = df["email_text"].astype(str).str.strip()
df["label"] = df["label"].astype(str).str.lower().str.strip()
# Keep only valid spam and ham records
df = df[
    df["email_text"].ne("") &
    df["label"].isin(["spam", "ham"])
].copy()
df.drop_duplicates(subset=["email_text", "label"], inplace=True)
df.reset_index(drop=True, inplace=True)
print("\nCleaned dataset shape:", df.shape)
print("\nClass distribution after cleaning:\n", df["label"].value_counts())
# Ensure both classes have sufficient records
if df["label"].nunique() != 2 or df["label"].value_counts().min() < 2:
    raise ValueError("The dataset must contain at least two spam and two ham emails.")
# Step 5: Separate input emails and target labels
X = df["email_text"]
y = df["label"]
# Step 6: Split data into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.25,
    random_state=42,
    stratify=y
)
print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))
# Step 7: Build a TF-IDF and Naive Bayes pipeline
model = Pipeline([
    ("tfidf", TfidfVectorizer(
        lowercase=True,
        stop_words="english",
        ngram_range=(1, 2)
    )),
    ("classifier", MultinomialNB())
])
# Step 8: Train the classification model
model.fit(X_train, y_train)
print("\nMODEL TRAINING COMPLETED")
# Step 9: Predict the classes of test emails
y_pred = model.predict(X_test)
# Step 10: Evaluate the model
print("\nAccuracy:",
      round(accuracy_score(y_test, y_pred) * 100, 2), "%")
print("\nClassification Report:")
print(classification_report(
    y_test,
    y_pred,
    labels=["ham", "spam"],
    zero_division=0
))
# Step 11: Display the confusion matrix
cm = confusion_matrix(y_test, y_pred, labels=["ham", "spam"])
disp = ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=["Ham", "Spam"]
)
disp.plot()
plt.title("Email Spam Classification")
plt.tight_layout()
plt.show()
emails = input("Enter the email:")
# Step 12: Enter email text and predict whether it is spam or ham
print("\nEMAIL SPAM DETECTOR")
print("Enter an email message to classify.")
print("Type 'exit' to stop.")
while True:
    email = input("\nEnter email text: ").strip()
    if email.lower() == "exit":
        print("Email spam detector stopped.")
        break
    if not email:
        print("Please enter some email text.")
        continue
    # Predict the email category using the trained model
    prediction = model.predict([email])[0]
    # Display the result
    print("Classification:", prediction.upper())
    # Display prediction probabilities
    probabilities = model.predict_proba([email])[0]
    for label, probability in zip(model.classes_, probabilities):
        print(f"{label.upper()} probability: {probability * 100:.2f}%")
