# Step 1: Import required libraries
import pandas as pd
import matplotlib.pyplot as plt
from scipy.cluster.hierarchy import dendrogram, linkage
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import AgglomerativeClustering
# Step 2: Load the external dataset or create a sample dataset
file_path = r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\IR\Mall_Customers.csv"
try:
    df = pd.read_csv(file_path)
    print("EXTERNAL DATASET LOADED SUCCESSFULLY")
except FileNotFoundError:
    df = pd.DataFrame({
        "CustomerID": range(1, 16),
        "AnnualIncome_k": [
            15, 18, 20, 22, 25,
            35, 38, 40, 42, 45,
            60, 65, 70, 75, 80
        ],
        "SpendingScore": [
            80, 75, 85, 70, 78,
            40, 45, 35, 50, 42,
            20, 25, 15, 30, 18
        ]
    })
    print("SAMPLE DATASET CREATED SUCCESSFULLY")
# Step 3: Explore the dataset
print("\nFirst five records:")
print(df.head())
print("\nDataset shape:", df.shape)
print("\nOriginal column names:")
print(df.columns.tolist())
print("\nDataset information:")
df.info()
# Step 4: Standardize column names
# Convert different column-name formats into a common format
def normalize_column_name(name):
    return "".join(ch.lower() for ch in str(name) if ch.isalnum())
column_map = {}
for col in df.columns:
    name = normalize_column_name(col)
    if name in ["customerid", "customer"]:
        column_map[col] = "CustomerID"
    elif name in [
        "annualincome", "annualincomek", "annualincomekdollar",
        "annualincomekdollars"
    ]:
        column_map[col] = "AnnualIncome"
    elif name in [
        "spendingscore", "spendingscore1100",
        "spendingscore100"
    ]:
        column_map[col] = "SpendingScore"
df.rename(columns=column_map, inplace=True)
# Step 5: Identify the required clustering features
# Support common variations in column names
if "AnnualIncome" not in df.columns:
    for col in df.columns:
        name = normalize_column_name(col)
        if "annualincome" in name:
            df.rename(columns={col: "AnnualIncome"}, inplace=True)
            break
if "SpendingScore" not in df.columns:
    for col in df.columns:
        name = normalize_column_name(col)
        if "spendingscore" in name:
            df.rename(columns={col: "SpendingScore"}, inplace=True)
            break
features = ["AnnualIncome", "SpendingScore"]
if not all(col in df.columns for col in features):
    raise ValueError(
        "Required income or spending-score columns were not found. "
        "Available columns: " + str(df.columns.tolist())
    )
# Step 6: Convert features to numeric values and handle missing data
X = df[features].apply(pd.to_numeric, errors="coerce")
# Remove rows where both clustering features are missing
X.dropna(how="all", inplace=True)
df = df.loc[X.index].copy()
# Fill remaining missing values with column means
X = X.fillna(X.mean())
if X.isnull().any().any() or len(X) < 3:
    raise ValueError("At least three valid customer records are required.")
print("\nDataset prepared for clustering:")
print(X.head())
print("\nValid customer records:", len(X))
# Step 7: Standardize the features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
# Step 8: Calculate the Ward linkage matrix
linkage_matrix = linkage(X_scaled, method="ward")
# Create labels for the dendrogram
if "CustomerID" in df.columns:
    labels = df["CustomerID"].astype(str).tolist()
else:
    labels = df.index.astype(str).tolist()
# Step 9: Display the dendrogram
plt.figure(figsize=(14, 6))
dendrogram(
    linkage_matrix,
    labels=labels,
    leaf_rotation=90,
    leaf_font_size=7
)
plt.title("Dendrogram - Agglomerative Hierarchical Clustering")
plt.xlabel("Customer ID / Record Index")
plt.ylabel("Euclidean Distance")
plt.tight_layout()
plt.show()
# Step 10: Apply Agglomerative Hierarchical Clustering
model = AgglomerativeClustering(
    n_clusters=3,
    linkage="ward",
    metric="euclidean"
)
df["Cluster"] = model.fit_predict(X_scaled)
# Step 11: Display customer cluster assignments
print("\nCUSTOMER CLUSTERING RESULTS:")
print(df.to_string(index=False))
# Step 12: Count customers in each cluster
print("\nNumber of customers in each cluster:")
print(df["Cluster"].value_counts().sort_index())
# Step 13: Visualize the clusters
plt.figure(figsize=(9, 6))
for cluster in sorted(df["Cluster"].unique()):
    cluster_data = df[df["Cluster"] == cluster]
    plt.scatter(
        cluster_data["AnnualIncome"],
        cluster_data["SpendingScore"],
        s=60,
        label=f"Cluster {cluster}"
    )
plt.xlabel("Annual Income (thousands)")
plt.ylabel("Spending Score (1-100)")
plt.title("Customer Segmentation Using Agglomerative Clustering")
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()
# Step 14: Calculate average values for each cluster
print("\nCLUSTER-WISE AVERAGE VALUES:")
print(df.groupby("Cluster")[features].mean().round(2))
# Step 15: Save the clustering results
output_file = r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\IR\Mall_Customers_Clustered.csv"
df.to_csv(output_file, index=False)
print("\nClustering results saved to:")
print(output_file)
