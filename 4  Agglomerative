import os
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import AgglomerativeClustering

# Step 1: Load or generate dataset
file_path = r"C:\Users\admin\Downloads\customer_clustering_dataset.csv"

if not os.path.exists(file_path):
    file_path = "customer_clustering_dataset.csv"

    if not os.path.exists(file_path):
        df_new = pd.DataFrame({
            "CustomerID": range(1, 16),
            "AnnualIncome_k": [
                15, 18, 20, 22, 25,
                35, 38, 40, 42, 45,
                60, 65, 70, 75, 80
            ],
            "SpendingScore": [
                80, 75, 85, 70, 78,
                40, 45, 35, 50, 42,
                20, 25, 15, 30, 18
            ]
        })

        df_new.to_csv(file_path, index=False)
        print("Dummy dataset created:", file_path)

df = pd.read_csv(file_path)

# Step 2: Select features and handle missing values
features = ["AnnualIncome_k", "SpendingScore"]

if not all(col in df.columns for col in features):
    raise ValueError("Dataset must contain AnnualIncome_k and SpendingScore.")

X = df[features].apply(pd.to_numeric, errors="coerce")
X = X.fillna(X.mean())

if X.isnull().any().any() or len(X) < 3:
    raise ValueError("Dataset needs at least 3 valid customer records.")

# Step 3: Standardize data
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Step 4: Apply Agglomerative Clustering
model = AgglomerativeClustering(
    n_clusters=3,
    linkage="ward"
)

df["Cluster"] = model.fit_predict(X_scaled)

# Step 5: Display results
print("\nCustomer Clustering Results:")
print(df.to_string(index=False))

print("\nNumber of Customers in Each Cluster:")
print(df["Cluster"].value_counts().sort_index())

