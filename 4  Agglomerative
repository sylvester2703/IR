plt.figure(figsize=(8, 5))

plt.scatter(
    X["AnnualIncome_k"],
    X["SpendingScore"],
    c=df["Cluster"],
    cmap="viridis",
    s=80
)

plt.xlabel("Annual Income (thousands)")
plt.ylabel("Spending Score")
plt.title("Agglomerative Hierarchical Clustering")
plt.tight_layout()
plt.show()

