# Build a web crawler to extract product names, prices and links.
import json
import requests
import pandas as pd
from bs4 import BeautifulSoup
from urllib.parse import urljoin, urlparse
# Step 1: Accept and validate the website URL
def normalize_url(url):
    url = url.strip()
    if not urlparse(url).scheme:
        url = "https://" + url
    parsed = urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.hostname:
        raise ValueError("Please enter a valid HTTP or HTTPS URL.")
    return url
# Step 2: Download and parse the webpage
def crawl_products(website_url):
    try:
        website_url = normalize_url(website_url)
    except ValueError as error:
        print("Invalid URL:", error)
        return
    headers = {
        "User-Agent": "Mozilla/5.0",
        "Accept-Language": "en-US,en;q=0.9"
    }
    try:
        response = requests.get(
            website_url,
            headers=headers,
            timeout=20
        )
        response.raise_for_status()
        print("HTTP Status:", response.status_code)
    except requests.RequestException as error:
        print("Request failed:", error)
        return
    soup = BeautifulSoup(response.content, "html.parser")
    products = []
    seen_links = set()
    # Step 3: Store each unique product
    def add_product(name, price, link):
        name = str(name or "").strip()
        if not name or not link:
            return
        product_url = urljoin(website_url, str(link))
        parsed = urlparse(product_url)
        if parsed.scheme not in ("http", "https") or not parsed.hostname:
            return
        if product_url in seen_links:
            return
        seen_links.add(product_url)
        products.append({
            "Product_Name": name,
            "Price": str(price or "N/A").strip(),
            "Product_Link": product_url
        })
    # Step 4: Extract structured product information if available
    def process_jsonld(data):
        if isinstance(data, list):
            for entry in data:
                process_jsonld(entry)
        elif isinstance(data, dict):
            if "@graph" in data:
                process_jsonld(data["@graph"])
            item_type = data.get("@type", "")
            types = item_type if isinstance(item_type, list) else [item_type]
            if any("product" in str(t).lower() for t in types):
                name = data.get("name")
                link = data.get("url", website_url)
                offers = data.get("offers", {})
                price = "N/A"
                if isinstance(offers, list):
                    offers = offers[0] if offers else {}
                if isinstance(offers, dict):
                    price = offers.get(
                        "price",
                        offers.get("lowPrice", "N/A")
                    )
                    if price == "N/A":
                        specification = offers.get("priceSpecification", {})
                        if isinstance(specification, dict):
                            price = specification.get("price", "N/A")
                add_product(name, price, link)
    for script in soup.select('script[type="application/ld+json"]'):
        try:
            process_jsonld(json.loads(script.string or script.get_text()))
        except (json.JSONDecodeError, TypeError):
            continue
    # Step 5: Extract Books to Scrape product cards
    for item in soup.select("article.product_pod"):
        link = item.select_one("h3 a[href]")
        price = item.select_one(".price_color")

        if link:
            # The title attribute contains the full book title
            name = link.get("title") or link.get_text(" ", strip=True)
            price_value = price.get_text(" ", strip=True) if price else "N/A"

            add_product(name, price_value, link.get("href"))
    # Step 6: Support common product containers on other websites
    if not products:
        selectors = [
            "[data-component-type='s-search-result']",
            ".product-card",
            ".product-item",
            ".product",
            "li.product"
        ]
        containers = []
        for selector in selectors:
            containers.extend(soup.select(selector))
        for item in containers:
            title = item.select_one(
                "[itemprop='name'], h2, h3, "
                ".product-title, .product-name"
            )
            link = item.select_one("a[href]")
            price = item.select_one(
                "[itemprop='price'], .price, .product-price, "
                ".price_color, .a-price .a-offscreen"
            )
            if title:
                name = title.get("content") or title.get_text(" ", strip=True)
            else:
                image = item.select_one("img[alt]")
                name = image.get("alt", "").strip() if image else ""
            price_value = "N/A"
            if price:
                price_value = (
                    price.get("content")
                    or price.get_text(" ", strip=True)
                )
            if link:
                add_product(name, price_value, link.get("href"))
    # Step 7: Display the results and save the CSV file
    if products:
        df = pd.DataFrame(products)
        # Save the CSV file in the current working directory
        output_path = "products.csv"
        df.to_csv(output_path, index=False, encoding="utf-8-sig")
        print("\nProducts found:", len(df))
        print(df.to_string(index=False))
        print("\nData saved to:", output_path)
    else:
        print("\nNo products detected.")
        print("The webpage may use different HTML or JavaScript rendering.")
# Step 8: Run the crawler
website_url = input("Enter website URL: ")
crawl_products(website_url)
